<!DOCTYPE html>
<html lang="uk">
<head>
    <meta charset="UTF-8">
    <title>Пособник спамера</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="container mt-4">
    <h1 class="mb-4">База електронних адрес</h1>
    
    <table class="table table-bordered table-striped">
        <thead class="table-dark">
            <tr>
                <th>Прізвище</th>
                <th>Ім'я</th>
                <th>По батькові</th>
                <th>Електронна адреса</th>
                <th>Дії</th>
            </tr>
        </thead>
        <tbody>
            {% for user in users %}
                <tr>
                    <td>{{ user.lastName }}</td>
                    <td>{{ user.firstName }}</td>
                    <td>{{ user.patronymic }}</td>
                    <td>{{ user.email }}</td>
                    <td>
                        <form action="/delete/{{ user._id }}" method="POST">
                            <button type="submit" class="btn btn-danger btn-sm">Видалити</button>
                        </form>
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="5" class="text-center">У базі поки немає жодної адреси</td>
                </tr>
            {% endfor %}
        </tbody>
    </table>

    <div class="card mb-4">
        <div class="card-body">
            <form action="/add" method="POST">
                <div class="row g-2">
                    <div class="col-md-3">
                        <input type="text" name="lastName" class="form-control" placeholder="Прізвище" required>
                    </div>
                    <div class="col-md-3">
                        <input type="text" name="firstName" class="form-control" placeholder="Ім'я" required>
                    </div>
                    <div class="col-md-2">
                        <input type="text" name="patronymic" class="form-control" placeholder="По батькові">
                    </div>
                    <div class="col-md-3">
                        <input type="email" name="email" class="form-control" placeholder="Електронна адреса" required>
                    </div>
                    <div class="col-md-1">
                        <button type="submit" class="btn btn-primary w-100">Додати</button>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <div class="card mb-4 border-primary">
        <div class="card-header bg-primary text-white">Відправити розсилку</div>
        <div class="card-body">
            <form action="/send" method="POST">
                <div class="mb-3">
                    <label class="form-label">Оберіть шаблон повідомлення:</label>
                    <select name="template" class="form-select">
                        <option value="promo">Повідомляємо вам про знижки!</option>
                        <option value="news">Спеціальні пропозиції для вас!</option>
                        <option value="custom">Написати власний текст нижче</option>
                    </select>
                </div>
                <div class="mb-3">
                    <label class="form-label">Введіть власний текст (якщо обрали опцію вище):</label>
                    <textarea name="customText" class="form-control" rows="3" placeholder="Ваш текст тут..."></textarea>
                </div>
                <button type="submit" class="btn btn-success w-100">Відправити всім адресатам!</button>
            </form>
        </div>
    </div>
</body>
</html>

